	partition Vini = m
		mode: import
		source =
				let
				    Origine = Csv.Document(File.Contents("C:\PowerBI\vini_puliti.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Intestazioni = Table.PromoteHeaders(Origine, [PromoteAllScalars=true]),
				    Tipi = Table.TransformColumnTypes(Intestazioni, {{"ID", Int64.Type}, {"Vino", type text}, {"Cantina", type text}, {"Paese", type text}, {"Provincia", type text}, {"Regione", type text}, {"Varieta", type text}, {"Annata", Int64.Type}, {"Punteggio", Int64.Type}, {"Prezzo", Int64.Type}, {"Fascia prezzo", type text}, {"Giudizio", type text}, {"Degustatore", type text}}, "en-US"),
