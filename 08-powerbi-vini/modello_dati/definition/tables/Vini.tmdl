table Vini
	lineageTag: 5b58ec86-0a24-403f-a760-224b5b964d78

	measure 'Numero vini' = COUNTROWS(Vini)
		formatString: #,0
		lineageTag: 348f9573-b15a-4a3a-b0bf-fc88a2a5d080

	measure 'Prezzo medio' = AVERAGE(Vini[Prezzo])
		formatString: \$#,0.00
		lineageTag: b664129e-8337-4358-925e-20f6ff9c6f8b

	measure 'Prezzo mediano' = MEDIAN(Vini[Prezzo])
		formatString: \$#,0
		lineageTag: ab2bbbca-0caf-4b2a-aacd-5352c1a3706e

	measure 'Punteggio medio' = AVERAGE(Vini[Punteggio])
		formatString: 0.0
		lineageTag: 685e74d5-2bb9-4ac4-96c1-e24962ced300

	measure 'Indice qualita prezzo' = AVERAGEX(Vini, DIVIDE(Vini[Punteggio], Vini[Prezzo]))
		formatString: 0.00
		lineageTag: 30cdbf04-8294-4150-9773-ec849b52c455

	measure 'Vini affare' = CALCULATE([Numero vini], Vini[Punteggio] >= 90, Vini[Prezzo] <= 20)
		formatString: #,0
		lineageTag: 651674f4-7fd3-49dd-979e-8883eb9f02af

	measure '% vini affare' = DIVIDE([Vini affare], [Numero vini])
		formatString: 0.0%
		lineageTag: 76642b46-3d27-4507-93f1-38ec9f125c6d

	measure '% vini eccellenti' = DIVIDE(CALCULATE([Numero vini], Vini[Punteggio] >= 90), [Numero vini])
		formatString: 0.0%
		lineageTag: bcfc6d89-4e66-467f-8c9e-7fb6763f5b0e

